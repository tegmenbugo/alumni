# =============================================================================
# ALUMNI TRACKING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# DİKKAT: Bu dosya bir şablondur (.env.example).
# Güvenlik gereği hassas şifreler, API tokenları ve gizli anahtarlar asla bu
# dosyaya yazılmaz ve GitHub'a yüklenmez.
#
# Sistemi çalıştırmak için bu dosyayı '.env' adıyla kopyalayınız:
#   cp .env.example .env
# ardından kendi yerel/gizli bilgilerinizi '.env' içine giriniz.
# =============================================================================

# Uygulama Temel Ayarları
APP_NAME="Alumni Tracking System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# Veritabanı Sürücüsü Seçimi (sqlite veya mysql)
# Varsayılan: sqlite (Sıfır kurulum, taşınabilir dosya)
DB_CONNECTION=sqlite

# SQLite Yapılandırması
DB_DATABASE=/var/www/html/data/alumni.sqlite

# MySQL / MariaDB Yapılandırması (docker-compose 'db' servisi için)
DB_HOST=db
DB_PORT=3306
DB_DATABASE_NAME=alumni_db
DB_USERNAME=alumni_user
DB_PASSWORD=your_secure_database_password_here
DB_ROOT_PASSWORD=your_root_database_password_here

# API & Swagger Ayarları
API_VERSION=1.0.0
CORS_ALLOWED_ORIGINS=*
